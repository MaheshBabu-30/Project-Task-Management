# ============================================================
# SECTION 12 — COMMON ERROR RESPONSES
# ============================================================

# 422 Unprocessable Entity — Schema / validation failure (Valibot)
#     Triggered when request body fields fail schema rules (wrong type, too short, bad email, etc.)
# {
#   "success": false,
#   "statusCode": 422,
#   "errors": [
#     { "field": "password", "message": "Password must be at least 8 characters" },
#     { "field": "email",    "message": "Invalid email address" }
#   ]
# }

# 400 Bad Request — Malformed JSON body
# {
#   "success": false,
#   "statusCode": 400,
#   "message": "Invalid JSON request body"
# }

# 401 Unauthorized — Missing or invalid token
# {
#   "success": false,
#   "statusCode": 401,
#   "message": "Authentication required"
# }

