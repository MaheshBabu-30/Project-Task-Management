# ============================================================
# SECTION 2 — AUTHENTICATION  (/api/auth)
# ============================================================

### 2.1  Login with email + password
# @name login
POST {{baseUrl}}/api/auth/login
Content-Type: application/json

{
  "email": "mahesh@example.com",
  "password": "SecurePass@123"
}

# --- cURL Script ---
# curl -s -X POST http://localhost:3000/api/auth/login \
#   -H "Content-Type: application/json" \
#   -d '{"email":"mahesh@example.com","password":"SecurePass@123"}'

# --- Expected Response 200 ---
# {
#   "success": true,
#   "data": {
#     "user": {
#       "id": "550f3665-fa87-47ea-a1dc-f2a5302a38b0",
#       "name": "Mahesh Babu",
#       "email": "mahesh@example.com",
#       "role": "admin",
#       "orgId": "b8ab1686-120c-4b27-b2fd-e9d7e69236f0"
#     },
#     "tokens": {
#       "accessToken": "eyJhbGci....",
#       "refreshToken": "eyJhbGci...."
#     }
#   }
# }

###

### 2.2  Refresh access token
# @name refreshSession
POST {{baseUrl}}/api/auth/refresh
Content-Type: application/json

{
  "refreshToken": "{{refreshToken}}"
}

# --- cURL Script ---
# curl -s -X POST http://localhost:3000/api/auth/refresh \
#   -H "Content-Type: application/json" \
#   -d '{"refreshToken":"<your_refresh_token>"}'

# --- Expected Response 200 ---
# {
#   "success": true,
#   "data": {
#     "tokens": {
#       "accessToken": "eyJhbGci....(new)",
#       "refreshToken": "eyJhbGci....(new)"
#     }
#   }
# }

###

### 2.3  Request OTP  (passwordless login — step 1)
# @name requestOtp
POST {{baseUrl}}/api/auth/request-otp
Content-Type: application/json

{
  "email": "mahesh@example.com"
}

# --- cURL Script ---
# curl -s -X POST http://localhost:3000/api/auth/request-otp \
#   -H "Content-Type: application/json" \
#   -d '{"email":"mahesh@example.com"}'

# --- Expected Response 200 ---
# {
#   "success": true,
#   "data": {
#     "message": "Verification code sent to your email"
#   }
# }

###

### 2.4  Verify OTP  (passwordless login — step 2)
# @name verifyOtp
POST {{baseUrl}}/api/auth/verify-otp
Content-Type: application/json

{
  "email": "mahesh@example.com",
  "otp": "482951"
}

# --- cURL Script ---
# curl -s -X POST http://localhost:3000/api/auth/verify-otp \
#   -H "Content-Type: application/json" \
#   -d '{"email":"mahesh@example.com","otp":"482951"}'

# --- Expected Response 200 ---
# {
#   "success": true,
#   "data": {
#     "user": {
#       "id": "550f3665-fa87-47ea-a1dc-f2a5302a38b0",
#       "name": "Mahesh Babu",
#       "email": "mahesh@example.com",
#       "role": "admin",
#       "orgId": "b8ab1686-120c-4b27-b2fd-e9d7e69236f0"
#     },
#     "tokens": {
#       "accessToken": "eyJhbGci....",
#       "refreshToken": "eyJhbGci...."
#     }
#   }
# }

###

### 2.5  Logout  [AUTH REQUIRED]
# @name logout
POST {{baseUrl}}/api/auth/logout
Content-Type: application/json
Authorization: Bearer {{accessToken}}

{
  "refreshToken": "{{refreshToken}}"
}

# --- cURL Script ---
# curl -s -X POST http://localhost:3000/api/auth/logout \
#   -H "Content-Type: application/json" \
#   -H "Authorization: Bearer <access_token>" \
#   -d '{"refreshToken":"<your_refresh_token>"}'

# --- Expected Response 200 ---
# {
#   "success": true,
#   "data": {
#     "message": "Successfully logged out"
#   }
# }


