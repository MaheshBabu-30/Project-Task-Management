# Each request block includes:
#   - The live request (send via REST Client)
#   - A cURL script you can paste in any terminal
#   - The fake expected response
#
# Variables — replace these before sending requests.
# ============================================================

@baseUrl      = http://localhost:3000
@accessToken  = eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.eyJ1c2VySWQiOiI1NTBmMzY2NS1mYTg3LTQ3ZWEtYTFkYy1mMmE1MzAyYTM4YjAiLCJyb2xlIjoiYWRtaW4iLCJvcmdJZCI6ImI4YWIxNjg2LTEyMGMtNGIyNy1iMmZkLWU5ZDdlNjkyMzZmMCIsImlhdCI6MTcxMzE5MjAwMCwiZXhwIjoxNzEzMjc4NDAwfQ.FAKE_SIGNATURE
@refreshToken = eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.REFRESH_TOKEN_PAYLOAD.FAKE_SIGNATURE

@orgId        = b8ab1686-120c-4b27-b2fd-e9d7e69236f0
@userId       = 550f3665-fa87-47ea-a1dc-f2a5302a38b0
@projectId    = a1b2c3d4-e5f6-7890-abcd-ef1234567890
@taskId       = d4e5f6a7-b8c9-0123-defg-456789abcdef
@commentId    = c0mment11-1111-1111-1111-111111111111
@attachmentId = att00001-0000-0000-0000-000000000001
@notifId      = notif001-0000-0000-0000-000000000001


