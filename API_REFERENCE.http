### 9.1  Get presigned S3 upload URL — attachment  [AUTH REQUIRED]
# @name getPresignedUploadUrl
POST {{baseUrl}}/api/uploads/presigned-url
Content-Type: application/json
Authorization: Bearer {{accessToken}}

{
  "fileName": "wireframes-v1.pdf",
  "contentType": "application/pdf",
  "folder": "attachments"
}

# --- cURL Script ---
# curl -s -X POST http://localhost:3000/api/uploads/presigned-url \
#   -H "Content-Type: application/json" \
#   -H "Authorization: Bearer <access_token>" \
#   -d '{"fileName":"wireframes-v1.pdf","contentType":"application/pdf","folder":"attachments"}'

# --- Expected Response 200 ---
# {
#   "success": true,
#   "data": {
#     "url": "https://s3.amazonaws.com/task-miller/attachments/d4e5f6a7/wireframes-v1.pdf?X-Amz-Signature=xyz456&X-Amz-Expires=300",
#     "key": "attachments/d4e5f6a7-b8c9-0123/wireframes-v1.pdf",
#     "expiresIn": 300
#   }
# }

# --- Upload workflow ---
# Step 1: Call this endpoint → get { url, key }
# Step 2: PUT the file binary directly to `url` (no auth header):
#           curl -s -X PUT "<presigned_url>" \
#             -H "Content-Type: application/pdf" \
#             --data-binary @wireframes-v1.pdf
# Step 3: Register the file via POST /api/tasks/:taskId/attachments/ using the returned `key`

###

