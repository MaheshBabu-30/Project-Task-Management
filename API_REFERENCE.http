Content-Type: application/json
Authorization: Bearer {{accessToken}}

{
  "title": "E-Commerce Platform",
  "description": "Build a full-stack e-commerce platform with cart, payments, and admin dashboard.",
  "logoUrl": "https://s3.amazonaws.com/task-miller/logos/ecommerce.png",
  "assignedUserIds": [
    "aaaa1111-bbbb-cccc-dddd-eeeeeeeeeeee"
  ]
}

